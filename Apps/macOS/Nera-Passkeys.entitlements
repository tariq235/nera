<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Nera.entitlements + passkeys for any website (FEAT-027). Used only by the entitled release build, which
     sets NERA_PASSKEYS_ENTITLED=YES and embeds a Developer ID provisioning profile that grants this managed
     capability (docs/security/passkeys.md). Keep the first three keys in sync with project.yml. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<key>com.apple.developer.web-browser.public-key-credential</key>
	<true/>
</dict>
</plist>
