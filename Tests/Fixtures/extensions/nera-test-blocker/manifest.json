{
  "manifest_version": 3,
  "name": "Nera Test Blocker",
  "version": "1.0",
  "description": "Conformance fixture: blocks ads.nera.test and marks pages from a content script.",
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "block",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Nera Test Blocker",
    "default_popup": "popup.html"
  },
  "key": ""
}
